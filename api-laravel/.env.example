# Configuración de la API. `iniciar-demo.sh` copia este archivo a `.env` la
# primera vez y completa las claves vacías marcadas con (auto) con valores
# aleatorios. Nada de este archivo es secreto: los secretos viven solo en `.env`.

APP_NAME=PANGI
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8100
APP_TIMEZONE=America/Santiago
APP_LOCALE=es

# ── Identidad de la clínica (correos, WhatsApp, recibos, asistente) ──────────
CLINICA_NOMBRE=PANGI
CLINICA_TELEFONO="+569 0000 0000"
CLINICA_DIRECCION="Av. Principal 1234, local 5, Puente Alto"

# ── Base de datos (la de docker-compose.yml en local) ────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3317
DB_DATABASE=pangi_demo
DB_USERNAME=pangi
DB_PASSWORD=pangi_local

# ── Claves propias (auto) ────────────────────────────────────────────────────
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=
SERVICE_API_KEY=
FICHAJE_DEVICE_TOKEN=

# ── Frontends ────────────────────────────────────────────────────────────────
# A dónde vuelve el cliente tras pagar y a dónde apuntan los enlaces de correo.
PORTAL_RESERVAS_URL=http://localhost:3101
# En producción, los dominios de los tres frontends separados por comas (CORS).
ORIGENES_PRODUCCION=

# ── Comportamiento seguro para una demo ──────────────────────────────────────
# Ningún correo automático (recordatorios, avisos preventivos) sale solo.
CORREOS_AUTOMATICOS=false
RECORDATORIOS_AVISO_AUTOMATICO=false
# El asistente contesta con su capa sin IA (servicios, valores, horario).
ASISTENTE_IA_ACTIVO=false
# Sin reCAPTCHA en local.
RECAPTCHA_DESACTIVADO=true
# Admins con acceso a importar datos y a la sección Sysop.
SYSOP_EMAILS=admin@pangi.demo
# A quién avisar cuando llega un mensaje del formulario de contacto (vacío = a nadie).
CONTACTO_NOTIFICAR_A=

# ── Integraciones (vacías = apagadas) ────────────────────────────────────────
# Sin Getnet, fuera de producción el pago del abono se SIMULA de punta a punta.
GETNET_LOGIN=
GETNET_SECRET_KEY=
GETNET_BASE_URL=https://checkout.test.getnet.cl
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="PANGI <noreply@pangi.demo>"
RESEND_API_KEY=
ANTHROPIC_API_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ── Laravel ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12
