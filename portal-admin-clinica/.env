# Valores de la demo en local. No hay secretos acá: todo VITE_* termina en el
# navegador. Para compilar contra otro servidor, pasar las variables al build
# (ver empaquetar-hosting.sh en la raíz).
VITE_CLINICA_NOMBRE=PANGI
VITE_API_URL=http://localhost:8100
VITE_SITIO_URL=http://localhost:3100
VITE_RESERVA_URL=http://localhost:3101
